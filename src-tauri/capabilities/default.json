{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "allow-get-diagnostics",
    "allow-storage-get-status",
    "allow-sync-list-pending",
    "allow-identity-get-status",
    "allow-identity-begin-login",
    "allow-identity-complete-login",
    "allow-identity-cancel-login",
    "allow-identity-list-accounts",
    "allow-identity-activate-account",
    "allow-identity-logout",
    "allow-sync-now",
    "allow-account-get-view",
    "allow-account-get-preferences",
    "allow-account-set-preference",
    "allow-account-update-details",
    "allow-account-update-policy",
    "allow-account-set-status"
  ]
}
